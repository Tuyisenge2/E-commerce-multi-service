# ================================================================
# VALUES YOU SET YOURSELF
# ================================================================
PORT=3001
DEV_MODE=development

# Use local for Docker/local PostgreSQL; use hosted for Neon or similar.
DB_HOSTED_MODE=local
DB_SCHEMA=users
SSL=false

# Inside Docker use postgresdb:5432. When running directly, use localhost:5433.
DB_DEV_URL=postgres://postgres:secret@postgresdb:5432/shoptrove
DB_TEST_URL=postgres://postgres:secret@postgresdb:5432/shoptrove_test

# External PostgreSQL provider URL; required only when DEV_MODE=production.
# Obtain it from Neon, Supabase, Railway, Render, AWS RDS, etc.
DB_PROD_URL=

# Generate these yourself; never commit their real values.
# Command: openssl rand -hex 32
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters

BASE_URL=http://localhost:3001/api/v1
DEFAULT_ROLE=BUYER

# Legacy options; leave empty until their behavior is configured.
PASS_EXPIRE_DURATION=
CLONE_TIME=
DEPLOYED_URL=
SERVER_URL=

# ================================================================
# EXTERNAL PROVIDER: GOOGLE OAUTH (required)
# Obtain these from Google Cloud Console > APIs & Services > Credentials.
# The service refuses to start until every value below is configured.
# ================================================================
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_ID=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/users/auth/google/callback

# ================================================================
# EXTERNAL PROVIDER: EMAIL (optional)
# EMAIL and PASSWORD come from your email provider. For Gmail, PASSWORD is a
# Google App Password, not your normal password. With this disabled, local
# registration skips delivery and creates an already-verified user.
# ================================================================
ENABLE_EMAIL=false
EMAIL=
PASSWORD=
SENDER_NAME=ShopTrove

# ================================================================
# EXTERNAL PROVIDER: CLOUDINARY (optional)
# Obtain these from the Cloudinary Console dashboard.
# ================================================================
ENABLE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_NAME=shoptrove
